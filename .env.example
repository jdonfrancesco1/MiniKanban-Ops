# Postgres connection string (required unless OPS_BOARD_DATABASE_URL is set).
# Live fleet: workspace Replit Postgres (host helium, db heliumdb).
# Autoscale Publish Secrets may inject an empty Neon DATABASE_URL; Replit hides
# the managed workspace URI so it cannot be copied in the Publish Secrets UI.
# Example placeholder only:
DATABASE_URL=postgresql://user:password@hostname/neondb?sslmode=require

# Optional override preferred by the ops board pool / getDb.
# Autoscale: if Publish DATABASE_URL is Neon, set this secret to the workspace
# Helium DATABASE_URL (do not paste the URI into docs or chat).
# OPS_BOARD_DATABASE_URL=

# Optional local Postgres for drizzle-kit without Neon:
# DATABASE_URL=postgresql://ops:ops@localhost:5432/minikanban_ops

# Fleet tenant secret only (tenant id `fleet`). Not a key into customer tenants.
# Browser login, MCP, and /api/ops/* for the fleet board use this value.
# Local/dev: if unset, the fleet gate is open.
# Production: if unset, fleet and customer routes fail closed (401).
# MCP connectors store this env on the server — never as a tool argument.
OPS_BOARD_SECRET=

# Optional signing key for customer session cookies.
# Never set this to OPS_BOARD_SECRET. If unset, customer cookie sessions fail closed.
# OPS_TENANT_SESSION_SECRET=

# Fleet-admin provision gate. Must differ from OPS_BOARD_SECRET.
# Unset fails closed (401), including local/dev. Never commit a real value.
# This is not a customer connector secret.
# OPS_PROVISION_SECRET=

# Origin written into a customer connector handoff. Not the fleet workers.dev host.
# If unset, POST /api/ops/provision uses the request origin unless that origin
# is the fleet board host, in which case the call is refused.
# OPS_PUBLIC_BASE_URL=

# Workers session RLS. wrangler.jsonc sets this to 1 so the Worker uses a
# synchronous query passthrough and set_config(..., false) after getDb().
# Hermetic Node tests set it to 0 to keep the BEGIN / is_local path.
# Leave unset locally unless you are reproducing the Workers client.
# OPS_TENANT_RLS_SESSION=

# Optional: set to production on the host.
# NODE_ENV=development
