# Postgres connection string (required).
# Live fleet: workspace Replit Postgres (host helium, db heliumdb).
# Autoscale Publish Secrets must use that same URI — not an empty Neon placeholder.
# Example placeholder only:
DATABASE_URL=postgresql://user:password@hostname/neondb?sslmode=require

# Optional local Postgres for drizzle-kit without Neon:
# DATABASE_URL=postgresql://ops:ops@localhost:5432/minikanban_ops

# Shared secret for the single-user ops board (browser + Orca).
# If unset, the board is open (useful for local/dev).
# If set, visitors enter this value to get a session cookie, and agents
# send it as Authorization: Bearer <secret> or X-Ops-Board-Secret.
OPS_BOARD_SECRET=

# Optional: set to production on the host.
# NODE_ENV=development
